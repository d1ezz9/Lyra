{
  "name": "lyra",
  "version": "0.1.0",
  "description": "Lyra — desktop music player for Linux (AppImage)",
  "repository": "https://github.com/example/lyra",
  "main": "dist-e/src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && npm run build:renderer",
    "dist": "npm run build && electron-builder --linux AppImage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src common --ext .ts,.tsx || true",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"common/**/*.ts\" || true"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.63.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "zustand": "^4.5.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dbus-next": "^0.10.2",
    "mpris-service": "^2.1.2",
    "music-metadata": "^10.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^4.5.0",
    "call-bind-apply-helpers": "1.0.2",
    "get-proto": "1.0.1",
    "get-intrinsic": "1.3.0",
    "dunder-proto": "1.0.1",
    "call-bind": "1.0.9",
    "hasown": "2.0.4",
    "function-bind": "1.1.2",
    "es-errors": "1.3.0",
    "es-object-atoms": "1.1.2",
    "es-define-property": "1.0.1",
    "gopd": "1.2.0",
    "math-intrinsics": "1.1.0",
    "has-symbols": "1.1.0"
  },
  "build": {
    "appId": "app.lyra.player",
    "productName": "Lyra",
    "artifactName": "Lyra-${version}-x86_64.AppImage",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "desktop": {
        "Name": "Lyra",
        "Comment": "Lyra music player",
        "StartupWMClass": "Lyra"
      }
    },
    "files": [
      "dist/**",
      "dist-e/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      }
    ]
  }
}
