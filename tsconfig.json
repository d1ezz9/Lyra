{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@common/*": ["common/*"], "@/*": ["src/*"] },
    "types": ["node", "vite/client"]
  },
  "include": ["src", "common", "vitest.config.ts"]
}
